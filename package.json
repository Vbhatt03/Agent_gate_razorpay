{
  "name": "agentgate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agentgate/gateway dev",
    "build": "pnpm -r build",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @agentgate/db generate",
    "db:migrate": "pnpm --filter @agentgate/db migrate",
    "db:seed": "pnpm --filter @agentgate/db seed",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "demo:buyer-agent": "pnpm --filter @agentgate/demo-buyer-agent start",
    "test:all": "tsx scripts/test-all.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}